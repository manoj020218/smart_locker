# Copy this to: VPS/deploy/.env.deploy
# Never commit real secrets.

# VPS SSH
DEPLOY_VPS_IP=0.0.0.0
DEPLOY_VPS_USER=root
DEPLOY_VPS_PASS=
DEPLOY_VPS_DIR=/root/projects/smart_locker

# PM2
DEPLOY_PM2_APP_NAME=smart-locker-api

# Public APK hosting (directory on VPS where nginx serves static files)
DEPLOY_APK_PUBLIC_DIR=/root/projects/smart_locker/public/apk
DEPLOY_APK_PUBLIC_BASE_URL=https://example.com/apk

# API endpoint for APK version tracking
DEPLOY_API_BASE_URL=https://example.com
DEPLOY_ADMIN_JWT=
