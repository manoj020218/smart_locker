PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=smart_locker

# Auth
JWT_SECRET=replace-with-strong-secret

# Device registration security
# Required when REQUIRE_DEVICE_PROVISION_KEY=true.
DEVICE_PROVISION_KEY=
# Keep true in production to block unauthorized registrations.
REQUIRE_DEVICE_PROVISION_KEY=true
# Optional device-id allowlist (comma-separated), e.g. dev-001,dev-002
DEVICE_REGISTRATION_ALLOWLIST=

# Development bypass flags (must stay false in production)
ALLOW_INSECURE_AUTH_BYPASS=false
ALLOW_INSECURE_DEVICE_KEY_BYPASS=false

# Firebase Admin (optional in local dev if auth bypass is true)
# You can set one of:
# 1) GOOGLE_APPLICATION_CREDENTIALS=<path to service account json>
# 2) FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
