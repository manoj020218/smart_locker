PORT=8080
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=smart_cabinet

# Auth
JWT_SECRET=replace-with-strong-secret

# Optional hard gate for first device provisioning. Keep empty to disable.
DEVICE_PROVISION_KEY=

# Development bypass flags (must stay false in production)
ALLOW_INSECURE_AUTH_BYPASS=false
ALLOW_INSECURE_DEVICE_KEY_BYPASS=false

# Firebase Admin (optional in local dev if auth bypass is true)
# You can set one of:
# 1) GOOGLE_APPLICATION_CREDENTIALS=<path to service account json>
# 2) FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
