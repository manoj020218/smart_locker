{
  "expo": {
    "name": "Smart Cabinet Admin",
    "slug": "smart-cabinet-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false
        }
      ]
    ],
    "platforms": ["android"],
    "android": {
      "package": "in.iotsoft.smartcabinet.admin",
      "versionCode": 1,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
